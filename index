    <style>
        :root {
            --bg-primary: #0d1117;
            --bg-secondary: #161b22;
            --bg-tertiary: #21262d;
            --text-primary: #c9d1d9;
            --text-secondary: #8b949e;
            --accent-green: #3fb950;
            --accent-cyan: #56d4dd;
            --accent-yellow: #d29922;
            --accent-red: #f85149;
            --accent-purple: #bc8cff;
            --accent-blue: #58a6ff;
            --border: #30363d;
            --shadow: rgba(0, 0, 0, 0.5);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Fira Code', 'JetBrains Mono', monospace;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            line-height: 1.6;
        }

        #matrix-canvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 0;
            opacity: 0.15;
            pointer-events: none;
        }

        .terminal-container {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .terminal-window {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 20px 50px var(--shadow);
            margin-bottom: 30px;
        }

        .terminal-header {
            background: var(--bg-tertiary);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid var(--border);
        }

        .terminal-btn {
            width: 14px; height: 14px;
            border-radius: 50%;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .terminal-btn:hover { transform: scale(1.2); }
        .btn-close { background: var(--accent-red); }
        .btn-minimize { background: var(--accent-yellow); }
        .btn-maximize { background: var(--accent-green); }

        .terminal-title {
            margin-left: 15px;
            font-size: 0.85rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .terminal-body {
            padding: 25px 30px;
            min-height: 400px;
        }

        .prompt {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .prompt-user { color: var(--accent-green); font-weight: 600; }
        .prompt-at { color: var(--text-secondary); }
        .prompt-host { color: var(--accent-cyan); font-weight: 600; }
        .prompt-path { color: var(--accent-yellow); }
        .prompt-symbol { color: var(--accent-green); }

        .typing-text { display: inline; }
        .cursor {
            display: inline-block;
            width: 10px;
            height: 1.2em;
            background: var(--accent-green);
            animation: blink 1s infinite;
            vertical-align: text-bottom;
            margin-left: 2px;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        .output {
            margin: 15px 0;
            padding-left: 20px;
            color: var(--text-primary);
            white-space: pre-wrap;
        }

        .output-success { color: var(--accent-green); }
        .output-info { color: var(--accent-blue); }
        .output-warning { color: var(--accent-yellow); }
        .output-error { color: var(--accent-red); }
        .output-purple { color: var(--accent-purple); }

        .nav-menu {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
            margin: 20px 0;
            padding: 15px;
            background: var(--bg-tertiary);
            border-radius: 8px;
            border: 1px solid var(--border);
        }

        .nav-item {
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.9rem;
            border: 1px solid transparent;
        }

        .nav-item:hover {
            background: var(--bg-secondary);
            border-color: var(--accent-green);
            color: var(--accent-green);
        }

        .nav-item.active {
            background: var(--accent-green);
            color: var(--bg-primary);
            font-weight: 600;
        }

        .section {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .section.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 25px;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 3px;
            background: linear-gradient(90deg, var(--accent-green), var(--accent-cyan));
            transform: scaleX(0);
            transition: transform 0.3s;
        }

        .card:hover::before { transform: scaleX(1); }
        .card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-green);
            box-shadow: 0 10px 30px rgba(63, 185, 80, 0.1);
        }

        .card-icon { font-size: 2.5rem; margin-bottom: 15px; }
        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--accent-cyan);
        }

        .card-desc {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        .card-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 15px;
        }

        .tag {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.75rem;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            color: var(--text-secondary);
        }

        .tag-green { border-color: var(--accent-green); color: var(--accent-green); }
        .tag-blue { border-color: var(--accent-blue); color: var(--accent-blue); }
        .tag-yellow { border-color: var(--accent-yellow); color: var(--accent-yellow); }
        .tag-purple { border-color: var(--accent-purple); color: var(--accent-purple); }

        .skill-bar { margin: 15px 0; }
        .skill-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .skill-track {
            height: 8px;
            background: var(--bg-tertiary);
            border-radius: 4px;
            overflow: hidden;
        }

        .skill-fill {
            height: 100%;
            border-radius: 4px;
            background: linear-gradient(90deg, var(--accent-green), var(--accent-cyan));
            transition: width 1.5s ease;
            width: 0;
        }

        .form-group { margin-bottom: 20px; }
        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .form-input {
            width: 100%;
            padding: 12px 15px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.95rem;
            transition: all 0.3s;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--accent-green);
            box-shadow: 0 0 0 3px rgba(63, 185, 80, 0.1);
        }

        textarea.form-input {
            min-height: 120px;
            resize: vertical;
        }

        .btn-submit {
            padding: 12px 30px;
            background: var(--accent-green);
            color: var(--bg-primary);
            border: none;
            border-radius: 8px;
            font-family: inherit;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(63, 185, 80, 0.3);
        }

        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 2px;
            background: var(--border);
        }

        .timeline-item {
            position: relative;
            margin-bottom: 30px;
            padding-left: 20px;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -36px; top: 5px;
            width: 12px; height: 12px;
            border-radius: 50%;
            background: var(--accent-green);
            border: 3px solid var(--bg-secondary);
        }

        .timeline-date {
            font-size: 0.8rem;
            color: var(--accent-yellow);
            margin-bottom: 5px;
        }

        .timeline-title { font-weight: 600; margin-bottom: 5px; }
        .timeline-desc {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .footer {
            text-align: center;
            padding: 30px;
            color: var(--text-secondary);
            font-size: 0.85rem;
            border-top: 1px solid var(--border);
            margin-top: 40px;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .social-link {
            width: 45px; height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            color: var(--text-primary);
            text-decoration: none;
            font-size: 1.2rem;
            transition: all 0.3s;
        }

        .social-link:hover {
            background: var(--accent-green);
            color: var(--bg-primary);
            transform: translateY(-3px);
        }

        .code-block {
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            margin: 15px 0;
            overflow-x: auto;
            font-size: 0.9rem;
        }

        .code-keyword { color: var(--accent-purple); }
        .code-string { color: var(--accent-green); }
        .code-function { color: var(--accent-blue); }
        .code-comment { color: var(--text-secondary); font-style: italic; }
        .code-number { color: var(--accent-yellow); }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-primary); }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-secondary); }

        @media (max-width: 768px) {
            .terminal-body { padding: 15px 20px; }
            .card-grid { grid-template-columns: 1fr; }
            .nav-menu { justify-content: center; }
        }

        .particles {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .particle {
            position: absolute;
            width: 4px; height: 4px;
            background: var(--accent-green);
            border-radius: 50%;
            opacity: 0.5;
            animation: float 15s infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 0.5; }
            90% { opacity: 0.5; }
            100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
        }

        .command-input-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 20px;
            padding: 15px;
            background: var(--bg-tertiary);
            border-radius: 8px;
            border: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .command-input {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text-primary);
            font-family: inherit;
            font-size: 1rem;
            outline: none;
            min-width: 200px;
        }

        .command-input::placeholder { color: var(--text-secondary); }
    </style>
</head>
